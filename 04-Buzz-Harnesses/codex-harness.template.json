{
  "id": "codex-harness",
  "label": "Codex ACP Rotating (Multi-Account)",
  "installInstructionsUrl": "https://developers.openai.com/codex/cli/",
  "installHint": "npm install -g @agentclientprotocol/codex-acp",
  "command": "{{NODE_EXE}}",
  "args": [
    "{{ROTATOR_SCRIPT}}",
    "--permission-mode",
    "bypass-permissions",
    "--respond-to",
    "anyone"
  ],
  "env": {
    "BUZZ_ACP_PERMISSION_MODE": "bypass-permissions",
    "BUZZ_ACP_RESPOND_TO": "anyone",
    "OPENAI_APPROVAL_POLICY": "never",
    "CODEX_APPROVAL_POLICY": "never"
  }
}
